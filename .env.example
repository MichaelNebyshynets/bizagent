# Настройки для `python run.py`. При первом запуске копируется в .env — правьте .env, а не этот файл.

# База: postgres (Docker из docker-compose.yml) или mock (данные в памяти, без Docker)
DB_BACKEND=postgres
DATABASE_URL=dbname=bizagent_db user=postgres password=postgres host=localhost port=5432

# Модель: openai_compat (Ollama, vLLM, облако) или mock (демо-заглушка без ИИ)
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
# Локальной модели на первом запросе может понадобиться время на загрузку в память
LLM_TIMEOUT_S=120

# Ключ подписи токенов входа. Оставьте пустым: run.py сгенерирует случайный и запишет в .env
JWT_SECRET=
